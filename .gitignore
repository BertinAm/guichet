# Virtual environment
.venv/
venv/

# Python
__pycache__/
*.py[cod]

# Generated forms for the main run: regenerable from the fixed seed in
# generate_forms.py, and there are hundreds of them.
data/

# data_field/ and data_probe/ are deliberately NOT ignored. They hold the
# stimuli for the post-hoc probes, which run outside the documented
# run.sh path, so a reader checking those results can see the exact forms
# the model was shown. 68 images, about 6 MB.

# Secrets
.env
*.key

# OS
Thumbs.db
.DS_Store

# NOTE: results/ is deliberately NOT ignored. runs.jsonl, results.md and
# report.html are the evidence and the deliverables, and the project claims
# they are in the repository.

# Original download drop. Superseded by the copies at the repo root, which carry
# the platform and encoding fixes. Kept on disk as a backup, excluded from the
# repo so nobody runs the stale copies by mistake. Safe to delete.
files/
